# ─────────────────────────────────────────
# Gemini API
# Obtenha sua chave GRATUITAMENTE em:
# https://aistudio.google.com/app/apikey
# Sem essa chave o app não inicia.
# ─────────────────────────────────────────
GEMINI_API_KEY=sua_chave_aqui

# ─────────────────────────────────────────
# Banco de dados MySQL
#
# A app roda localmente em ambos os casos,
# então DB_HOST=localhost funciona sempre:
#   - Docker:      a porta 3306 é mapeada para localhost
#   - MySQL local: conecta diretamente
#
# Se usar Docker (recomendado):
#   DB_USER=finance_user
#   DB_PASSWORD=Finance@2026  ← já definidas abaixo
#
# Se usar MySQL local:
#   DB_USER=seu_usuario
#   DB_PASSWORD=sua_senha  ← substitua abaixo
# ─────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=finance_user
DB_PASSWORD=Finance@2026
DB_NAME=personal_finance
TABLE_NAME=transactions

# ─────────────────────────────────────────
# Logs
# Níveis: DEBUG | INFO | WARNING | ERROR
# ─────────────────────────────────────────
LOG_LEVEL=INFO